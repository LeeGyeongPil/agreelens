{
  "name": "agreelens",
  "version": "0.1.0",
  "description": "Check whether your LLM judge agrees with human labels - kappa, alpha, confusion matrix and disagreement review in one local HTML file.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "start": "npm run build && node scripts/open-dist.mjs",
    "test": "vitest run",
    "check:dist": "node scripts/check-dist.mjs",
    "smoke:dist": "node scripts/smoke-dist.mjs"
  },
  "files": [
    "dist/index.html"
  ],
  "dependencies": {
    "papaparse": "5.7.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.1.0"
  },
  "keywords": [
    "llm-judge",
    "evaluation",
    "cohen-kappa",
    "krippendorff-alpha",
    "inter-rater-agreement"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeeGyeongPil/agreelens.git"
  }
}
